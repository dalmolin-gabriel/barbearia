{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barbearia",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Sem database_id: o wrangler 4 cria o D1 sozinho no primeiro deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "padilhas", "migrations_dir": "migrations" }
  ],
  // Preserva as variáveis e secrets criados no painel do Cloudflare a cada deploy.
  // Aqui só ficam valores fixos; as chaves (Turnstile, VAPID) são cadastradas no painel.
  "keep_vars": true,
  "vars": {
    "VAPID_SUBJECT": "mailto:contato@exemplo.com"
  }
}
